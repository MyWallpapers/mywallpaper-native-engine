include_guard(GLOBAL)

# Upstream is verified by the root build. Local extensions are a reviewed patch.
find_package(Git REQUIRED)
set(_mw_backend_output_root "${CMAKE_BINARY_DIR}/_deps/mw_retained_backend")
set(_mw_backend_patch "${CMAKE_CURRENT_LIST_DIR}/../third_party/patches/resident-hooks.patch")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mw_backend_patch}")
file(SHA256 "${_mw_backend_patch}" _mw_patch_sha)
set(_mw_backend_stamp "${_mw_backend_output_root}/patch.sha256")
set(_mw_previous_patch "")
if(EXISTS "${_mw_backend_stamp}")
    file(READ "${_mw_backend_stamp}" _mw_previous_patch)
endif()
foreach(_mw_generated src/MinHook.c src/SlimDetours/Transaction.c src/SlimDetours/Trampoline.c src/SlimDetours/MwResidentPolicy.c)
    if(NOT EXISTS "${_mw_backend_output_root}/${_mw_generated}")
        set(_mw_previous_patch "")
    endif()
endforeach()
if(NOT _mw_previous_patch STREQUAL _mw_patch_sha)
    foreach(_mw_relative MinHook.c SlimDetours/Transaction.c SlimDetours/Trampoline.c)
        get_filename_component(_mw_directory "${_mw_backend_output_root}/src/${_mw_relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${_mw_directory}")
        configure_file("${MW_MINHOOK_SOURCE}/src/${_mw_relative}"
            "${_mw_backend_output_root}/src/${_mw_relative}" COPYONLY)
    endforeach()
    file(REMOVE "${_mw_backend_output_root}/src/SlimDetours/MwResidentPolicy.c")
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --check "${_mw_backend_patch}"
        WORKING_DIRECTORY "${_mw_backend_output_root}"
        RESULT_VARIABLE _mw_check_result ERROR_VARIABLE _mw_patch_error)
    if(NOT _mw_check_result EQUAL 0)
        message(FATAL_ERROR "Resident backend patch check failed: ${_mw_patch_error}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply "${_mw_backend_patch}"
        WORKING_DIRECTORY "${_mw_backend_output_root}"
        RESULT_VARIABLE _mw_apply_result ERROR_VARIABLE _mw_patch_error)
    if(NOT _mw_apply_result EQUAL 0)
        message(FATAL_ERROR "Resident backend patch failed: ${_mw_patch_error}")
    endif()
    file(WRITE "${_mw_backend_stamp}" "${_mw_patch_sha}")
endif()
set(MW_PATCHED_MINHOOK_SOURCE "${_mw_backend_output_root}/src/MinHook.c")
set(MW_PATCHED_TRANSACTION_SOURCE "${_mw_backend_output_root}/src/SlimDetours/Transaction.c")
set(MW_PATCHED_TRAMPOLINE_SOURCE "${_mw_backend_output_root}/src/SlimDetours/Trampoline.c")
set(MW_RESIDENT_POLICY_SOURCE "${_mw_backend_output_root}/src/SlimDetours/MwResidentPolicy.c")
